# Certificates for signature checking
CONFIG_SYSTEM_TRUSTED_KEYS="verity.x509.pem"

# Platform
CONFIG_MACH_XIAOMI_MSM8953=y
CONFIG_MACH_XIAOMI_TISSOT=y
# CONFIG_MACH_XIAOMI_TIFFANY is not set
# CONFIG_MACH_XIAOMI_MIDO is not set
# CONFIG_MACH_XIAOMI_DAISY is not set
# CONFIG_MACH_XIAOMI_SAKURA is not set
# CONFIG_MACH_XIAOMI_ROSY is not set
# CONFIG_MACH_XIAOMI_VINCE is not set
# CONFIG_MACH_XIAOMI_YSL is not set

# A/B partition support (tissot ships with seamless updates)
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
# Forces normal boot path — required for A/B slot booting
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# SCSI Transports
CONFIG_BLK_DEV_MD=y
CONFIG_MD_LINEAR=y
# CONFIG_DM_DEFAULT_KEY is not set
CONFIG_DM_ANDROID_VERITY=y

# CODEC drivers
CONFIG_SND_SOC_MAX98927=y

# Fingerprint
CONFIG_FINGERPRINT_FPC1020=y
CONFIG_FINGERPRINT_GOODIX_GF3208=y


# CPU voltage control (UV_mV_table), see docs/oc-uc.md
CONFIG_MSM8953_CPU_VOLTAGE_CONTROL=y

# Android 12+ boosts tasks via cpu.uclamp.* in task_profiles.json and no
# longer mounts the schedtune cgroup; the two are mutually exclusive.
# See docs/oc-uc.md
# CONFIG_SCHED_TUNE is not set
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# Don't run at Fmax (2.4 GHz OC) until userspace picks a governor
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Let reclaim scan anon pages even while inactive file pages remain, so
# idle app memory is pushed to zram instead of only dropping page cache
CONFIG_BALANCE_ANON_FILE_RECLAIM=y

# MGLRU experiment: runtime fallback via /sys/kernel/mm/lru_gen/enabled.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
CONFIG_LOCALVERSION="-perf-mglru-next"

# Secondary algorithms are opt-in per device; lz4 remains primary.
CONFIG_ZRAM_MULTI_COMP=y

# Backport-survey hardening flips (2026-10-08): supported by this tree and
# toolchain (clang-22, ARMv8.0 A53); verified satisfiable Kconfig deps.
# SCS uses software x18 reservation, no HW PAC/BTI needed.
CONFIG_SHADOW_CALL_STACK=y
# Sibling bengal/msm8937 defconfigs set both; SLUB is in use.
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
# Extends already-on HARDENED_USERCOPY; watch dmesg for driver false positives.
CONFIG_HARDENED_USERCOPY_PAGESPAN=y
# Pairs with already-on INIT_ON_ALLOC; disable via init_on_free=0 if slow.
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# f2fs compression: code+Kconfig present (fs/f2fs/compress.c), was off.
# Sub-algos default y under COMPRESSION; hold ZSTD until LZ4/LZO soak
# (A53 compress-CPU cost), keep LZ4HC (on-disk compatible with LZ4).
CONFIG_F2FS_FS_COMPRESSION=y
# CONFIG_F2FS_FS_ZSTD is not set
CONFIG_EROFS_FS_ZIP_ZSTD=y

# ThinLTO via clang; replaces the LTO_NONE default. Booted on tissot
# 2026-10-08 (Image.gz-dtb 17.5 MB, clean boot, 14/14 app launches).
# CFI stays off until its own image passes a boot test — a CFI violation panics.
CONFIG_LTO_CLANG=y
# ACK 6.18's device tree is patched so its ramoops uses the same address and
# zone layout as this kernel's (0x91400000, the one address that is both CAF's
# ramoops base and real System RAM on this phone). persistent_ram_post_init()
# keeps a buffer whose signature matches and exposes the previous contents, so
# after a failed ACK boot the log is readable here at
# /sys/fs/pstore/console-ramoops-0. Remove once the ACK port is working.
